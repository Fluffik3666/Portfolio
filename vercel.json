{
  "version": 2,
  "regions": [
    "lhr1"
  ],
  "builds": [
    {
      "src": "src/main.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{src/static/images/**,new/**,venv/**,.venv/**,**/__pycache__/**,.env}"
      }
    },
    {
      "src": "src/static/images/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/favicon.ico",
      "dest": "/src/static/images/icons/favicon.ico",
      "headers": {
        "Cache-Control": "public, max-age=604800, s-maxage=31536000"
      }
    },
    {
      "src": "/apple-touch-icon(-precomposed)?.png",
      "dest": "/src/static/images/icons/apple-touch-icon.png",
      "headers": {
        "Cache-Control": "public, max-age=604800, s-maxage=31536000"
      }
    },
    {
      "src": "/static/images/derived/(.*)",
      "dest": "/src/static/images/derived/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, s-maxage=31536000, immutable"
      }
    },
    {
      "src": "/static/images/(.*)",
      "dest": "/src/static/images/$1",
      "headers": {
        "Cache-Control": "public, max-age=604800, s-maxage=31536000, stale-while-revalidate=604800"
      }
    },
    {
      "src": "/(.*)",
      "dest": "src/main.py"
    }
  ]
}
