{
    "version": 2,
    "builds": [
      {
        "src": "src/main.py",
        "use": "@vercel/python",
        "config": { "includeFiles": "src/static/**" }
      },
      {
        "src": "src/static/images/**",
        "use": "@vercel/static"
      }
    ],
    "routes": [
      {
        "src": "/static/images/(.*)",
        "dest": "/src/static/images/$1"
      },
      {
        "src": "/(.*)",
        "dest": "src/main.py"
      }
    ]
  }
